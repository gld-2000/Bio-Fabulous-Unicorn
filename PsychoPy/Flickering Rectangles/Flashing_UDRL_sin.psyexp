      <CodeComponent name="code_flicker" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="import numpy as np&amp;#10;&amp;#10;# frequencies in Hz (sinusoidal luminance modulation)&amp;#10;freqs_hz = {&amp;#10;    'rectTop': 13.5,&amp;#10;    'rectBottom': 12.0,&amp;#10;    'rectLeft': 10.0,&amp;#10;    'rectRight': 8.5,&amp;#10;}&amp;#10;&amp;#10;rects = {}" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="flicker = {&quot;rectTop&quot;: {&quot;framesPerCycle&quot;: 4, &quot;color&quot;: &quot;cyan&quot;}, &quot;rectBottom&quot;: {&quot;framesPerCycle&quot;: 6, &quot;color&quot;: &quot;magenta&quot;}, &quot;rectLeft&quot;: {&quot;framesPerCycle&quot;: 8, &quot;color&quot;: &quot;yellow&quot;}, &quot;rectRight&quot;: {&quot;framesPerCycle&quot;: 10, &quot;color&quot;: &quot;red&quot;}};&amp;#10;rects = {};&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="rects[&quot;rectTop&quot;] = rectTop;&amp;#10;rects[&quot;rectBottom&quot;] = rectBottom;&amp;#10;rects[&quot;rectLeft&quot;] = rectLeft;&amp;#10;rects[&quot;rectRight&quot;] = rectRight;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="rects['rectTop'] = rectTop&amp;#10;rects['rectBottom'] = rectBottom&amp;#10;rects['rectLeft'] = rectLeft&amp;#10;rects['rectRight'] = rectRight&amp;#10;&amp;#10;# record 5 seconds worth (or entire routine)&amp;#10;rec_v = {name: [] for name in freqs_hz.keys()}&amp;#10;rec_t = []" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="t_sec = frameN / 60.0  # assumes 60 Hz; we'll also estimate actual below&amp;#10;&amp;#10;for name, f in freqs_hz.items():&amp;#10;    a = 0.5 * (1.0 + np.sin(2 * np.pi * f * t_sec))  # 0..1&amp;#10;    v = 2*a - 1  # -1..1&amp;#10;&amp;#10;    rect = rects[name]&amp;#10;    rect.fillColor = (v, v, v)&amp;#10;    rect.lineColor = rect.fillColor&amp;#10;&amp;#10;    rec_v[name].append(v)" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="print(&quot;nFrames logged:&quot;, len(next(iter(rec_v.values()))))&amp;#10;&amp;#10;# estimate fps from PsychoPy's recorded frame intervals if available&amp;#10;# (If this fails, we fall back to 60)&amp;#10;fps = 60.0&amp;#10;try:&amp;#10;    fps_est = 1.0 / np.mean(win.frameIntervals)&amp;#10;    if np.isfinite(fps_est) and fps_est &gt; 1:&amp;#10;        fps = fps_est&amp;#10;except Exception:&amp;#10;    pass&amp;#10;&amp;#10;print(&quot;Estimated fps:&quot;, fps)&amp;#10;&amp;#10;for name, sig in rec_v.items():&amp;#10;    x = np.array(sig)&amp;#10;    x = x - x.mean()&amp;#10;    freqs = np.fft.rfftfreq(len(x), d=1/fps)&amp;#10;    X = np.abs(np.fft.rfft(x))&amp;#10;    idx = np.argmax(X[1:]) + 1&amp;#10;    print(name, &quot;peak at&quot;, freqs[idx], &quot;Hz&quot;)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_flicker" valType="code" updates="None" name="name"/>
