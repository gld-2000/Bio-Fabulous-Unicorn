      <Param name="name" updates="None" val="loopP2" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="trial"/>
    <LoopTerminator name="loopP2"/>
    <Routine name="finish"/>
  </Flow>
