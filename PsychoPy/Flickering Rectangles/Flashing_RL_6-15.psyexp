  <Flow>
    <Routine name="setup"/>
    <Routine name="ready"/>
    <LoopInitiator loopType="TrialHandler" name="loopP1">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('direction', '↓')]), OrderedDict([('direction', '↑')]), OrderedDict([('direction', '→')]), OrderedDict([('direction', '←')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="10" valType="num"/>
      <Param name="name" updates="None" val="loopP1" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="trial"/>
    <LoopTerminator name="loopP1"/>
    <Routine name="pause"/>
    <Routine name="ready"/>
    <LoopInitiator loopType="TrialHandler" name="loopP2">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
